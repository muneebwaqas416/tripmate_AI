# LLM provider (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Web search (https://tavily.com)
TAVILY_API_KEY=

# Postgres for LangGraph conversation memory.
# Leave empty to use in-memory checkpoints (conversations lost on restart).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripmate

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
